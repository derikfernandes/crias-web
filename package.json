{
  "name": "crias-trilha",
  "private": true,
  "workspaces": [
    "frontend/crias-painel",
    "frontend/crias-aluno"
  ],
  "scripts": {
    "dev": "npm run dev -w crias-painel",
    "dev:admin": "npm run dev -w crias-painel",
    "dev:aluno": "npm run dev -w crias-aluno",
    "build": "npm run build -w crias-painel && npm run build -w crias-aluno && node scripts/copy-aluno-dist.mjs && node scripts/sync-painel-dist-root.mjs",
    "build:admin": "npm run build -w crias-painel",
    "build:aluno": "npm run build -w crias-aluno",
    "lint": "npm run lint -w crias-painel",
    "typecheck": "npm run typecheck -w crias-painel && npm run typecheck -w crias-aluno",
    "test": "node --test scripts/contract-*.test.mjs scripts/check-design-boundaries.mjs scripts/agent-usage.test.mjs && vitest run",
    "validate:chatis-flow": "node scripts/validate-chatis-flow.mjs",
    "check:design-boundaries": "node --test scripts/check-design-boundaries.mjs",
    "preview": "npm run preview -w crias-painel",
    "audit:trilha-integrity": "node scripts/audit-trilha-integrity.js",
    "passwords:generate": "node scripts/generate-student-passwords.mjs",
    "prompts:seed": "npx --yes tsx scripts/seed-ai-prompts.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "firebase-admin": "^13.7.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/pdf-parse": "^1.1.5",
    "jsdom": "^29.1.1",
    "vitest": "^3.2.7"
  }
}
