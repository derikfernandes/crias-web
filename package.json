{
  "name": "crias-trilha",
  "private": true,
  "workspaces": [
    "frontend/trilha-admin",
    "frontend/cria-frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w trilha-admin",
    "dev:admin": "npm run dev -w trilha-admin",
    "dev:aluno": "npm run dev -w cria-frontend",
    "build": "npm run build -w trilha-admin && npm run build -w cria-frontend && node scripts/copy-aluno-dist.mjs",
    "build:admin": "npm run build -w trilha-admin",
    "build:aluno": "npm run build -w cria-frontend",
    "lint": "npm run lint -w trilha-admin",
    "typecheck": "npm run typecheck -w trilha-admin && npm run typecheck -w cria-frontend",
    "test": "node --test scripts/contract-*.test.mjs scripts/check-design-boundaries.mjs scripts/agent-usage.test.mjs && vitest run",
    "check:design-boundaries": "node --test scripts/check-design-boundaries.mjs",
    "preview": "npm run preview -w trilha-admin",
    "audit:trilha-integrity": "node scripts/audit-trilha-integrity.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "firebase-admin": "^13.7.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/pdf-parse": "^1.1.5",
    "jsdom": "^29.1.1",
    "vitest": "^3.2.7"
  }
}
